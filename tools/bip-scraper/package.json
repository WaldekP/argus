{
  "name": "bip-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lokalne narzedzie do mapowania i pobierania dokumentow ze stron BIP. Zero zaleznosci: Node 24+ (wbudowany sqlite, fetch, natywny TypeScript).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
